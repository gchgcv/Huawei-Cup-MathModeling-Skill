{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/huawei-cup-review/review-request-v2.schema.json",
  "title": "Huawei Cup Read-only Review Request v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "artifacts", "review_lenses", "policy"],
  "properties": {
    "contract_version": {"const": "2"},
    "task_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "kind", "path"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["paper", "pdf", "figure", "table", "code", "result", "citation", "context", "project_facts"]},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
        }
      }
    },
    "review_lenses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["academic_prose", "ai_style", "defensive_writing", "argument_depth", "claim_evidence", "abstract", "section_coherence", "figures_tables", "numbers_terms", "references", "document_quality"]}
    },
    "known_limitations": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only_required", "allow_artifact_writes", "allow_automatic_repair"],
      "properties": {
        "read_only_required": {"const": true},
        "allow_artifact_writes": {"const": false},
        "allow_automatic_repair": {"const": false}
      }
    }
  }
}
