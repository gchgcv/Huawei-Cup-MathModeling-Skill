{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/huawei-cup-review/review-result-v2.schema.json",
  "title": "Huawei Cup Read-only Review Result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "task_id", "call_status", "status_meaning", "read_only", "writes_performed", "findings", "limitations"],
  "properties": {
    "contract_version": {"const": "2"},
    "task_id": {"type": "string", "minLength": 1},
    "call_status": {"enum": ["SUCCESS", "CONTRACT_ERROR"]},
    "status_meaning": {"const": "CALL_SUCCESS_ONLY_NOT_PAPER_QUALITY"},
    "read_only": {"const": true},
    "writes_performed": {"type": "array", "maxItems": 0},
    "findings": {
      "type": "array",
      "items": {"$ref": "https://local.invalid/huawei-cup-shared/review-finding-v1.schema.json"}
    },
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
