{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/huawei-cup-shared/review-finding-v1.schema.json",
  "title": "Huawei Cup Review Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["finding_id", "rule_id", "severity", "category", "claim", "location", "evidence", "recommendation", "confidence", "limitations"],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{3}$"},
    "severity": {"enum": ["P0", "P1", "P2"]},
    "category": {"type": "string", "minLength": 1},
    "claim": {"type": "string", "minLength": 1},
    "location": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "locator", "reason"],
        "properties": {
          "artifact_id": {"type": "string", "minLength": 1},
          "locator": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "quote": {"type": "string"}
        }
      }
    },
    "recommendation": {"type": "string", "minLength": 1},
    "confidence": {"enum": ["low", "medium", "high"]},
    "limitations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
